# PostgreSQL 16 + PostGIS
POSTGRES_USER=caramuru
POSTGRES_PASSWORD=caramuru
POSTGRES_DB=caramuru
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://caramuru:caramuru@localhost:5432/caramuru

# Redis 7
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=caramuru-evidence
MINIO_USE_SSL=false

# API
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-in-production
# Configure SECRET_KEY with at least 32 random bytes; sync rejects the scaffold placeholder.
JWT_ISSUER=caramuru-api
JWT_AUDIENCE=caramuru-field
SYNC_MAX_FUTURE_SKEW_MS=300000
CORS_ORIGINS=http://localhost:3000
